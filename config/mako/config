# Catppuccin Mocha, mauve accent
font=JetBrainsMono Nerd Font 11
border-size=2
border-radius=8
padding=12
margin=10
width=360
height=140
anchor=top-right
default-timeout=6000
max-visible=4
icons=0

# Colours (and per-urgency border colours) generated by scripts/ai-os-theme
include=~/.config/ai-os/theme/mako

[urgency=low]
default-timeout=4000

[urgency=critical]
default-timeout=0
