# ai-os agent sandbox: Claude Code in a throwaway rootless container.
# Build: ai-os-sandbox build
FROM docker.io/library/node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep jq curl ca-certificates less procps python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force
ENV DISABLE_AUTOUPDATER=1 HOME=/home/node
USER node
WORKDIR /work
