// Waybar for ai-os (Omarchy-style): floating bar; menu, workspaces and window title left,
// clock centre, status right. Margins and rounding match Hyprland gaps_out/rounding (look.conf).
{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": ["custom/menu", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "cpu", "memory", "bluetooth", "network", "pulseaudio", "battery"],

  "custom/menu": {
    "format": "",
    "tooltip-format": "System menu (SUPER+ESC)",
    "on-click": "ai-os-menu"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace m-1",
    "on-scroll-down": "hyprctl dispatch workspace m+1"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },
  "cpu": {
    "format": "󰓅  {usage}%",
    "interval": 5,
    "on-click": "ai-os-popup btop"
  },
  "memory": {
    "format": "󰍛  {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "ai-os-popup btop"
  },
"clock": {
    "format": "{:%a %d %b   %H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": { "icon-size": 18, "spacing": 12 },
  "bluetooth": {
    "on-click": "ai-os-popup bluetui",
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-no-controller": "",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "network": {
    "on-click": "ai-os-popup nmtui",
    "on-click-right": "nm-connection-editor",
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁿", "󰂁", "󰁹"]
  }
}
