#!/bin/bash
# Easy multi-monitor setup for Hyprland.
#   ai-os-display                 menu (also SUPER+SHIFT+M and the system menu)
#   ai-os-display status          monitors, scale, DPI, layout
#   ai-os-display layout <extend-right|extend-left|mirror>   remembered
#   ai-os-display laptop-only | external-only                this session only (a reload or replug restores)
#   ai-os-display scale <monitor> <value>    e.g. scale HDMI-A-1 1.5   (only valid fractional scales are accepted)
#   ai-os-display mode <monitor> <WxH@Hz>    e.g. mode HDMI-A-1 2560x1440@60
#   ai-os-display reset           forget saved settings and re-detect (smart scale for external screens)
#   ai-os-display watch           autostarted: runs hotplug/safety when Hyprland reports a monitor added/removed
#   ai-os-display hotplug|safety  register a new monitor / never leave every screen off
# Settings are saved by monitor description (so they survive a different port) in ~/.config/ai-os/monitors.json
# and written as rules to ~/.config/ai-os/monitors.conf, which config/hypr/monitors.conf sources.
set -u
STATE="$HOME/.config/ai-os/monitors.json"; GEN="$HOME/.config/ai-os/monitors.conf"
mkdir -p "$(dirname "$STATE")"
if [ "${1:-}" = watch ]; then   # long-running: no lock; each event runs a fresh, locked instance
  sock="${XDG_RUNTIME_DIR:-/tmp}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:?not running under Hyprland}/.socket2.sock"
  # Reconnect for as long as this Hyprland instance lives: the socket may not exist yet at autostart,
  # and socat can lose the connection. Each (re)connect runs hotplug once to catch events missed meanwhile.
  while [ -d "${sock%/*}" ]; do
    if [ -S "$sock" ]; then
      "$0" hotplug
      socat -U - "UNIX-CONNECT:$sock" 2>/dev/null | while IFS= read -r ev; do
        case "$ev" in monitoradded\>\>*) "$0" hotplug ;; monitorremoved\>\>*) "$0" safety ;; esac
      done
    fi
    sleep 2
  done
  exit 0
fi
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ai-os-display.lock"; flock 9      # serialise: hotplug events can arrive in bursts

cur() { hyprctl monitors all -j; }
is_internal() { case "$1" in eDP*|LVDS*|DSI*) return 0 ;; *) return 1 ;; esac; }
internal_name() { cur | jq -r '[.[]|select(.name|test("^(eDP|LVDS|DSI)"))][0].name // empty'; }
pick() { printf '%s\n' "$@" | fuzzel --dmenu --prompt "  " 2>/dev/null; }
note() { notify-send -t 2500 "Displays" "$1" 2>/dev/null; echo "$1"; }

# valid_scales <w> <h>: scales (1.00-3.00) where both logical dimensions are whole numbers
valid_scales() { awk -v w="$1" -v h="$2" 'BEGIN{for(i=100;i<=300;i+=5){s=i/100; a=w/s; b=h/s; if(a==int(a+0.5)*1.0 && b==int(b+0.5)*1.0 && (a-int(a+0.5))^2<1e-9 && (b-int(b+0.5))^2<1e-9) printf "%g\n", s}}'; }
# smart_scale <w> <h> <physical-width-mm>: valid scale nearest to dpi/96
smart_scale() {
  local w=$1 h=$2 pw=$3 ideal
  [ "${pw:-0}" -gt 0 ] 2>/dev/null || { echo 1; return; }
  ideal=$(awk -v w="$w" -v pw="$pw" 'BEGIN{printf "%.3f", (w/(pw/25.4))/96}')
  ideal=$(awk -v i="$ideal" 'BEGIN{if(i>2)i=2; if(i<1)i=1; print i}')   # sane range: 1.0 - 2.0
  valid_scales "$w" "$h" | awk -v t="$ideal" 'BEGIN{best=1; d=99} {x=$1-t; if(x<0)x=-x; if(x<d){d=x; best=$1}} END{print best}'
}

save() { jq "$1" "$STATE" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"; }
init_state() { [ -f "$STATE" ] || echo '{"layout":"extend-right","monitors":{}}' > "$STATE"; }

# add_missing seed|smart: register monitors not yet saved. seed keeps today's runtime scale; smart picks a scale from DPI.
add_missing() {
  local desc name w h pw rr sc s
  while IFS=$'\t' read -r desc name w h pw rr sc; do
    case "$name" in HEADLESS*|Virtual*|FALLBACK*) continue ;; esac   # virtual outputs are not real screens
    jq -e --arg d "$desc" '.monitors[$d]' "$STATE" >/dev/null 2>&1 && continue
    if [ "$1" = seed ]; then s="$sc"; elif is_internal "$name"; then s=1; else s="$(smart_scale "$w" "$h" "$pw")"; fi
    local internal=false; is_internal "$name" && internal=true
    save ".monitors[\"$desc\"] = {internal: $internal, mode: \"preferred\", scale: $s}"
    echo "registered: $name ($desc) scale $s"
  done < <(cur | jq -r '.[]|[(if .description=="" then .name else .description end),.name,.width,.height,.physicalWidth,.refreshRate,.scale]|@tsv')
}

generate() {
  jq -r --arg lap "$(internal_name)" '
    .layout as $l | .monitors | to_entries[] | .key as $d | .value as $v |
    "monitor = \(if ($d|test("^(eDP|DP|HDMI|DVI|VGA|LVDS|DSI)-?[A-Za-z0-9-]*$")) then $d else "desc:" + $d end), \($v.mode), \(if $v.internal then "0x0" elif $l == "extend-left" then "auto-left" else "auto-right" end), \($v.scale)\(if ($v.internal|not) and $l == "mirror" and $lap != "" then ", mirror, \($lap)" else "" end)"' "$STATE"
}
apply() {
  { echo "# Generated by ai-os-display: do not edit (layout: $(jq -r .layout "$STATE"))"; generate; } > "$GEN"
  hyprctl reload >/dev/null 2>&1; sleep 1
  local err; err="$(hyprctl configerrors 2>&1 | head -3)"; [ -n "$err" ] && echo "config errors: $err" >&2
  safety_check
}
safety_check() { # never leave every screen disabled
  [ "$(cur | jq '[.[]|select(.disabled|not)]|length')" -eq 0 ] && { hyprctl reload >/dev/null 2>&1; note "All screens were off: restored."; }
  return 0
}

status() {
  init_state; add_missing seed >/dev/null
  echo "layout: $(jq -r .layout "$STATE")"
  cur | jq -r '.[]|[.name,.description,"\(.width)x\(.height)@\(.refreshRate|floor)","scale \(.scale)","at \(.x),\(.y)",(if .disabled then "OFF" else "on" end),(if .mirrorOf != "none" then "mirror of \(.mirrorOf)" else "" end),"\((.width / (.physicalWidth / 25.4))|floor) dpi"]|@tsv' | column -t -s$'\t'
}

find_mon() { cur | jq -r --arg n "$1" '.[]|select(.name==$n)|(if .description=="" then .name else .description end)' | head -1; }
set_scale() { # <monitor> <value>
  local d w h; d="$(find_mon "$1")"; [ -n "$d" ] || { echo "no such monitor: $1 (try: ai-os-display status)" >&2; return 1; }
  read -r w h < <(cur | jq -r --arg n "$1" '.[]|select(.name==$n)|"\(.width) \(.height)"')
  valid_scales "$w" "$h" | grep -qx "$2" || { echo "scale $2 is not valid for ${w}x${h}; valid: $(valid_scales "$w" "$h" | tr '\n' ' ')" >&2; return 1; }
  init_state; add_missing seed >/dev/null; save ".monitors[\"$d\"].scale = $2"; apply; note "$1 scale $2"
}
set_mode() { # <monitor> <WxH@Hz>
  local d; d="$(find_mon "$1")"; [ -n "$d" ] || { echo "no such monitor: $1" >&2; return 1; }
  cur | jq -r --arg n "$1" '.[]|select(.name==$n)|.availableModes[]' | grep -qx "${2}Hz" || [ "$2" = preferred ] || { echo "mode $2 not offered by $1" >&2; return 1; }
  init_state; add_missing seed >/dev/null; save ".monitors[\"$d\"].mode = \"$2\""; apply; note "$1 mode $2"
}
set_layout() { case "$1" in extend-right|extend-left|mirror) ;; *) echo "layout: extend-right|extend-left|mirror" >&2; return 1 ;; esac
  init_state; add_missing seed >/dev/null; save ".layout = \"$1\""; apply; note "Layout: $1"; }

session_only() { # laptop-only | external-only: runtime only, never saved
  local lap ext; lap="$(internal_name)"; ext="$(cur | jq -r --arg l "$lap" '.[]|select(.name!=$l)|.name')"
  [ -n "$lap" ] && [ -n "$ext" ] || { note "Needs a laptop panel and at least one external screen."; return 1; }
  if [ "$1" = laptop-only ]; then for e in $ext; do hyprctl keyword monitor "$e,disable" >/dev/null; done
  else hyprctl keyword monitor "$lap,disable" >/dev/null; fi
  note "$1 (this session; unplugging or 'ai-os-display layout …' restores)"
}

menu() {
  init_state; add_missing seed >/dev/null
  local a; a="$(pick "Extend right" "Extend left" "Mirror laptop" "Laptop only (this session)" "External only (this session)" "Set scale…" "Set resolution…" "Reset to smart defaults" "Show status")"
  case "$a" in
    "Extend right") set_layout extend-right ;; "Extend left") set_layout extend-left ;; "Mirror laptop") set_layout mirror ;;
    "Laptop only"*) session_only laptop-only ;; "External only"*) session_only external-only ;;
    "Set scale…")
      local m w h hint s sel; m="$(pick_monitor)" || exit 0; read -r w h < <(cur | jq -r --arg n "$m" '.[]|select(.name==$n)|"\(.width) \(.height)"')
      hint="$(smart_scale "$w" "$h" "$(cur | jq -r --arg n "$m" '.[]|select(.name==$n)|.physicalWidth')")"
      sel="$(for s in $(valid_scales "$w" "$h"); do printf '%s  ->  %s%s\n' "$s" "$(awk -v w="$w" -v h="$h" -v s="$s" 'BEGIN{printf "%dx%d", w/s+0.5, h/s+0.5}')" "$([ "$s" = "$hint" ] && echo "   (suggested)")"; done | pick_lines)" || exit 0
      set_scale "$m" "${sel%% *}" ;;
    "Set resolution…")
      local m r; m="$(pick_monitor)" || exit 0
      r="$(cur | jq -r --arg n "$m" '.[]|select(.name==$n)|.availableModes[]' | sed 's/Hz$//' | sort -t@ -k1,1Vr -k2,2nr | awk -F@ '!s[$1]++' | pick_lines)" || exit 0
      [ -n "$r" ] && set_mode "$m" "$r" ;;
    "Reset"*) rm -f "$STATE"; init_state; add_missing smart; apply; note "Reset to smart defaults" ;;
    "Show status") status | fuzzel --dmenu --prompt "  " >/dev/null 2>&1 ;;
  esac
}
pick_lines() { fuzzel --dmenu --prompt "  " 2>/dev/null; }
pick_monitor() { local list; list="$(cur | jq -r '.[]|select(.disabled|not)|"\(.name)  (\(.description))"')"; [ "$(echo "$list" | wc -l)" -le 1 ] && { echo "${list%% *}"; return; }; list="$(echo "$list" | pick_lines)" || return 1; echo "${list%% *}"; }

case "${1:-menu}" in
  menu) menu ;;
  status) status ;;
  layout) set_layout "${2:-}" ;;
  laptop-only|external-only) session_only "$1" ;;
  scale) set_scale "${2:-}" "${3:-}" ;;
  mode) set_mode "${2:-}" "${3:-}" ;;
  reset) rm -f "$STATE"; init_state; add_missing smart; apply ;;
  scales) valid_scales "${2:-0}" "${3:-0}" ;;                 # debug: valid scales for a resolution
  suggest) smart_scale "${2:-0}" "${3:-0}" "${4:-0}" ;;       # debug: suggested scale for w h physical-width-mm
  generate) init_state; add_missing seed >/dev/null; generate ;;
  hotplug) init_state; sleep 1; if add_missing smart | grep -q registered; then apply; fi; safety_check ;;
  safety) sleep 1; safety_check ;;
  *) sed -n '2,16p' "$0"; exit 1 ;;
esac
