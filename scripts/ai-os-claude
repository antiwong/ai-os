#!/bin/sh
# Claude Code scratchpad: a floating Ghostty on special workspace "claude".
# First press launches it; later presses toggle it (the session keeps running).
if hyprctl clients -j | jq -e '.[]|select(.class=="ai-os.claude")' >/dev/null; then
  exec hyprctl dispatch hl.dsp.workspace.toggle_special\(\"claude\"\)
fi
setsid -f ghostty --gtk-single-instance=false --class=ai-os.claude --title="Claude Code" -e claude >/dev/null 2>&1
