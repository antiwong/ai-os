#!/bin/bash
# AMD panel power saving ("ABM"): the amdgpu driver can dim the backlight and boost pixel values to save
# power on the built-in panel. Level 0 = off, 1-4 = increasing savings and visible colour/contrast change.
#
#   ai-os-panel status            current level, AC state, whether the auto rule is installed
#   ai-os-panel set <0-4>         set the level now (resets at reboot unless the rule is installed)
#   ai-os-panel install [level]   udev rule: <level> (default 3) on battery, 0 on AC; applies it now
#   ai-os-panel uninstall         remove the rule and set level 0
#   ai-os-panel test [secs] [lvl] unplugged A/B: measure battery draw at level 0 vs <lvl> (default 3), 0-lvl-0-lvl
#   ai-os-panel why               explain why writes fail with "busy" (who holds the DRM property)
#   ai-os-panel --print-rule [level]   show the udev rule without installing
# Writing needs root: the script re-runs itself with sudo when it must.
set -u
RULE=/etc/udev/rules.d/90-ai-os-panel.rules
GLOB="${AI_OS_PANEL_GLOB:-/sys/class/drm/card*-eDP-*/amdgpu/panel_power_savings}"   # override only for testing
PS="${AI_OS_PANEL_PS:-/sys/class/power_supply}"
files() { compgen -G "$GLOB" || true; }
need_root() { [ "$(id -u)" = 0 ] || [ "${AI_OS_PANEL_SKIP_ROOT:-0}" = 1 ] || exec sudo "$(readlink -f "$0")" "$@"; }
valid() { case "${1:-}" in 0|1|2|3|4) return 0 ;; *) echo "level must be 0-4" >&2; return 1 ;; esac; }
ac_online() { for d in $PS/*; do [ "$(cat "$d/type" 2>/dev/null)" = Mains ] && { cat "$d/online"; return; }; done; echo 1; }
battery_dir() { for d in $PS/BAT*; do [ -d "$d" ] && { echo "$d"; return; }; done; }
current() { local f; f="$(files | head -1)"; [ -n "$f" ] && cat "$f"; }
# The driver exposes the same control as a DRM connector property. If some program (e.g. KWin on the login
# screen) has set it to anything but "sysfs", the kernel answers sysfs writes with "busy" and only the DRM
# master (the compositor) can change it back.
abm_prop() { # prints: sysfs|off|min|bias-min|bias-max|max|unknown ; nothing if it cannot be read
  command -v modetest >/dev/null || return 1
  local v; v="$(modetest -M amdgpu -c 2>/dev/null | awk '/\teDP-[0-9]+/ {on=1; next} /^[0-9]+\t[0-9]+\t/ && !/eDP/ {on=0} on && /adaptive backlight modulation/ {f=1} f && /value:/ {print $2; exit}')"
  case "$v" in 18446744073709551615) echo sysfs ;; 0) echo off ;; 1) echo min ;; 2) echo bias-min ;; 3) echo bias-max ;; 4) echo max ;; "") return 1 ;; *) echo unknown ;; esac
}
explain_locked() {
  local a; a="$(abm_prop)" || return 0
  [ "$a" = sysfs ] && return 0
  echo "Why: the DRM property 'adaptive backlight modulation' is set to '$a' by another program (on this system most likely" >&2
  echo "KWin on the login screen). While it is not 'sysfs', the kernel refuses sysfs writes with 'busy'. Only the display" >&2
  echo "master (your compositor) can change it, and Hyprland has no setting for it. This script cannot override that." >&2
}
LAST_ERR=""
setlevel() { # setlevel <0-4>: retries because the driver can answer "busy" while the compositor holds the display
  local f n err
  for f in $(files); do
    for n in 1 2 3 4 5 6; do
      err="$( { echo "$1" > "$f"; } 2>&1 )" && continue 2
      sleep 0.4
    done
    LAST_ERR="${err#*write error: }"; LAST_ERR="${LAST_ERR##*: }"; return 1
  done
}

rule() { # rule <battery-level>
  local lvl="$1" loop='for f in /sys/class/drm/card*-eDP-*/amdgpu/panel_power_savings; do for i in 1 2 3 4 5; do echo %s > $$f 2>/dev/null && break; sleep 0.4; done; done'
  cat <<R
# ai-os-panel: AMD panel power saving ${lvl} on battery, off on AC. Remove with: ai-os-panel uninstall
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="/bin/sh -c '$(printf "$loop" "$lvl")'"
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="1", RUN+="/bin/sh -c '$(printf "$loop" 0)'"
R
}

status() {
  local f; f="$(files | head -1)"
  [ -n "$f" ] || { echo "no AMD eDP panel power-saving control found (pattern: $GLOB)"; return 1; }
  echo "panel power saving: level $(cat "$f") of 4  ($f)"
  echo "AC: $([ "$(ac_online)" = 1 ] && echo plugged || echo unplugged)"
  a="$(abm_prop)" && { if [ "$a" = sysfs ]; then echo "DRM property: sysfs (this script can control it)"; else echo "DRM property: '$a' - sysfs control is LOCKED by another program; writes will fail with 'busy' (see: ai-os-panel why)"; fi; }
  if [ -f "$RULE" ]; then echo "auto rule: installed ($(grep -o 'echo [0-9]' "$RULE" | head -1 | tr -d 'echo ') on battery, 0 on AC)"; else echo "auto rule: not installed (run: ai-os-panel install)"; fi
}

draw() { # average battery draw in W over $1 seconds
  local b n=0 sum=0 p; b="$(battery_dir)"
  for ((i = 0; i < $1; i += 2)); do p=$(<"$b/power_now"); sum=$((sum + p)); n=$((n + 1)); sleep 2; done
  awk -v s="$sum" -v n="$n" 'BEGIN{printf "%.2f", s/n/1e6}'
}

test_levels() {
  local secs="${1:-20}" lvl="${2:-3}" b i w
  valid "$lvl" || exit 1
  b="$(battery_dir)"; [ -n "$b" ] || { echo "no battery"; exit 1; }
  [ "$(cat "$b/status")" = Discharging ] || { echo "unplug the charger first (battery must be Discharging)"; exit 1; }
  ORIG_LEVEL="$(current)"   # global on purpose: the EXIT trap runs after this function returns
  trap 'setlevel "$ORIG_LEVEL"' EXIT
  echo "Measuring ${secs}s per step after a ${AI_OS_PANEL_SETTLE:-8}s settle; leave the machine alone. Sequence: 0, $lvl, 0, $lvl"
  declare -A sum cnt
  for i in 0 "$lvl" 0 "$lvl"; do
    setlevel "$i"; sleep "${AI_OS_PANEL_SETTLE:-8}"
    w="$(draw "$secs")"; printf '  level %s: %s W\n' "$i" "$w"
    sum[$i]=$(awk -v a="${sum[$i]:-0}" -v b="$w" 'BEGIN{print a+b}'); cnt[$i]=$(( ${cnt[$i]:-0} + 1 ))
  done
  local a0 aL
  a0=$(awk -v s="${sum[0]}" -v n="${cnt[0]}" 'BEGIN{printf "%.2f", s/n}'); aL=$(awk -v s="${sum[$lvl]}" -v n="${cnt[$lvl]}" 'BEGIN{printf "%.2f", s/n}')
  awk -v a="$a0" -v l="$aL" -v lv="$lvl" 'BEGIN{printf "\naverage: level 0 = %.2f W, level %s = %.2f W  ->  saves %.2f W (%.1f%%)\n", a, lv, l, a-l, (a-l)*100/a}'
  setlevel "$ORIG_LEVEL"; trap - EXIT
  echo "Restored level $ORIG_LEVEL. Differences under ~0.2 W are within noise."
}

case "${1:-status}" in
  status) status ;;
  set) valid "${2:-}" || exit 1; need_root "$@"
       if setlevel "$2"; then echo "level set to $2 (now: $(current))"; else echo "could not set level $2: ${LAST_ERR:-unknown error} (still: $(current))" >&2; explain_locked; exit 1; fi ;;
  install)
    lvl="${2:-3}"; valid "$lvl" || exit 1; need_root "$@"
    rule "$lvl" > "$RULE" && echo "wrote $RULE" && udevadm control --reload 2>/dev/null
    want=$lvl; [ "$(ac_online)" = 1 ] && want=0
    if setlevel "$want"; then
      echo "applied now: level $want for the current power state (AC $( [ "$(ac_online)" = 1 ] && echo plugged || echo unplugged )); it switches automatically on plug/unplug"
    else
      echo "WARNING: the rule is installed, but writing level $want failed now: ${LAST_ERR:-unknown error} (level is still $(current))." >&2
      explain_locked
      echo "The rule uses the same write, so it will fail the same way until that lock is gone ('ai-os-panel uninstall' removes it)." >&2
    fi
    echo "note: it is not re-applied at boot until the next AC change; run 'ai-os-panel set $lvl' if you boot unplugged" ;;
  uninstall) need_root "$@"; rm -f "$RULE"; udevadm control --reload 2>/dev/null; setlevel 0; echo "rule removed, level 0" ;;
  test) need_root "$@"; test_levels "${2:-20}" "${3:-3}" ;;
  why) a="$(abm_prop)" && echo "DRM property 'adaptive backlight modulation' = $a"; explain_locked; [ "${a:-}" = sysfs ] && echo "Nothing is locking it; sysfs control should work."; true ;;
  --print-rule) valid "${2:-3}" && rule "${2:-3}" ;;
  *) sed -n '2,17p' "$0"; exit 1 ;;
esac
